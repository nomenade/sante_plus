# URL de l'API backend en production
# Remplacez cette URL par celle de votre backend déployé
VITE_API_URL=https://sante-plus-backend.onrender.com/api

# ============================================================
# IA CONVERSATIONNELLE — GOOGLE GEMINI : l'IA qui répond aux users
#
# Obtenez une clé API Gemini sur Google AI Studio :
# https://aistudio.google.com/apikey  (compte Google requis, gratuit)
#
# RECOMMANDÉ (SÉCURISÉ) : gardez la clé sur votre BACKEND, elle n'est
# jamais visible par les visiteurs → ajoutez dans les variables
# d'environnement du backend (Render) : GEMINI_API_KEY=...
# Le frontend utilise déjà automatiquement le proxy /api/ai/gemini.
#
# SIMPLE (dev local) : VITE_GEMINI_API_KEY (embarquée dans le JS du
# navigateur — ⚠️ accessible à tout visiteur) OU un fichier .env.local.
#
# Modèle (optionnel) — "gemini-3-flash" = rapide et polyvalent :
# VITE_GEMINI_MODEL=gemini-3-flash
#
# Repli secondaire — Groq (https://console.groq.com) :
# VITE_GROQ_API_KEY=gsk_votre_cle_ici
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
#
# Ancienne voie GROK (xAI) — non utilisée par défaut, mais gardée :
# VITE_GROK_API_KEY=xai-votre_cle_ici
# VITE_GROK_MODEL=grok-3-mini
#
# Vision alternative OpenAI (déjà supportée) :
# VITE_OPENAI_API_KEY=sk-votre_cle_openai
# Sans aucune clé, le moteur de règles local prend le relais.
# ============================================================